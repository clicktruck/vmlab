{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string"
    },
    "os": {
      "type": "string",
      "enum": [
        "windows",
        "linux"
      ]
    },
    "needs": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "default": {
            "type": "string"
          },
          "secret": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "kind": {
                "type": "string",
                "const": "reboot"
              },
              "timeout_seconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "kind",
              "timeout_seconds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "script": {
                "type": "string",
                "minLength": 1
              },
              "run_as": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(admin|system|user:[A-Za-z0-9_.-]+)$"
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expect": {
                "type": "object",
                "properties": {
                  "exit_code": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "output_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "output_not_contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "output_matches": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "script",
              "run_as",
              "timeout_seconds",
              "expect"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "name",
    "description",
    "os",
    "needs",
    "steps"
  ],
  "additionalProperties": false
}
